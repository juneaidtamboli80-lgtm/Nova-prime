import{useEffect,useRef,useState}from'react';import{Activity,Camera,Contact,Globe,MapPin,Mic,MicOff,Phone,Power,Settings,Sparkles,Volume2,X,ShieldCheck,KeyRound,Eye,EyeOff}from'lucide-react';import{getKey,saveKey,testKey,maskKey}from'./lib/keyStore';
import{Camera as NativeCamera}from'@capacitor/camera';import{Geolocation}from'@capacitor/geolocation';import{LocalNotifications}from'@capacitor/local-notifications';import{Capacitor,registerPlugin}from'@capacitor/core';import{LiveSession,NovaState,Persona}from'./lib/LiveSession';
const DeviceControl=registerPlugin<{requestNativePermission(options:{permission:string}):Promise<{permission:string;granted:boolean}>}>('DeviceControl');
const labels:Record<NovaState,string>={disconnected:'READY WHEN YOU ARE',connecting:'CONNECTING TO NOVA',listening:'LISTENING',speaking:'NOVA IS SPEAKING'};
export default function App(){
 const[state,setState]=useState<NovaState>('disconnected'),[persona,setPersona]=useState<Persona>('female'),[settings,setSettings]=useState(false),[notice,setNotice]=useState('Tap the core to start a voice session.'),[error,setError]=useState(''),[perm,setPerm]=useState<Record<string,string>>({});
 const live=useRef<LiveSession|null>(null),busy=state!=='disconnected';
 const[apiKey,setApiKey]=useState(getKey()),[showKey,setShowKey]=useState(false),[keyMsg,setKeyMsg]=useState(''),[saved,setSaved]=useState(getKey());
 function onSaveKey(){try{saveKey(apiKey);setSaved(apiKey.trim());setKeyMsg(apiKey.trim()?'Saved ✓ Ab session start kar sakte ho.':'Key hata di gayi.');}catch{setKeyMsg('Save nahi ho paya.');}}
 async function onTestKey(){if(!apiKey.trim()){setKeyMsg('Pehle key paste karo.');return;}setKeyMsg('Testing…');const r=await testKey(apiKey);setKeyMsg(r==='ok'?'Key valid ✓':r);}
 useEffect(()=>()=>{void live.current?.disconnect()},[]);
 async function toggle(){setError('');if(busy){await live.current?.disconnect();live.current=null;return;}try{live.current=new LiveSession(setState,setError,setNotice);await live.current.connect(persona);}catch(e){setError(e instanceof Error?e.message:'Unable to connect');setState('disconnected');await live.current?.disconnect();live.current=null;}}
 async function request(k:string){try{
  if(!Capacitor.isNativePlatform()){if(k==='microphone'){const s=await navigator.mediaDevices.getUserMedia({audio:true});s.getTracks().forEach(t=>t.stop());}else if(k==='location'){await new Promise<void>((ok,no)=>navigator.geolocation.getCurrentPosition(()=>ok(),no));}else{setPerm(p=>({...p,[k]:'Manage in Android App info if requested.'}));return;}}
  else if(k==='camera'||k==='photos'){const r=await NativeCamera.requestPermissions({permissions:k==='camera'?['camera']:['photos']});setPerm(p=>({...p,[k]:JSON.stringify(r)}));return;}
  else if(k==='location'){const r=await Geolocation.requestPermissions();setPerm(p=>({...p,[k]:JSON.stringify(r)}));return;}
  else if(k==='notifications'){const r=await LocalNotifications.requestPermissions();setPerm(p=>({...p,[k]:JSON.stringify(r)}));return;}
  else if(k==='microphone'||k==='contacts'||k==='phone'){
   const r=await DeviceControl.requestNativePermission({permission:k});
   setPerm(p=>({...p,[k]:r.granted?'Allowed ✓':'Denied — enable in Android Settings → App permissions.'}));
   return;
  }else{setPerm(p=>({...p,[k]:'This permission is not supported yet.'}));return;}
  setPerm(p=>({...p,[k]:'Permission request completed.'}));
 }catch(e){setPerm(p=>({...p,[k]:e instanceof Error?e.message:'Permission denied.'}));}}
 const items=[['camera','Camera',Camera],['microphone','Microphone',Mic],['photos','Photos & videos',Activity],['notifications','Notifications',Volume2],['contacts','Contacts',Contact],['location','Location',MapPin],['phone','Phone',Phone]] as const;
 return <main className="shell"><header><div className="brand"><span><Sparkles/></span><div><b>NOVA</b><small>PERSONAL AI</small></div></div><button className="gear" onClick={()=>setSettings(true)}><Settings/></button></header>
 <section className="hero"><div className="status"><i className={state}/>{labels[state]}</div><div className={'orb '+state}><div className="ring r1"/><div className="ring r2"/><div className="core"><Sparkles size={40}/></div></div><h1>Hello, I'm <em>NOVA</em></h1><p>{state==='listening'?'I’m all ears. What’s on your mind?':state==='speaking'?'One moment. I’ve got this.':state==='connecting'?'Opening your live session…':'Your world, with a little more intelligence.'}</p><div className="bars">{Array.from({length:31},(_,i)=><i key={i} style={{animationDelay:`${i*.04}s`}}/>)}</div><button className={'power '+(busy?'on':'')} onClick={toggle}>{busy?<MicOff/>:<Power/>}</button><small className="tap">{busy?'TAP TO END SESSION':'TAP TO TALK'}</small><div className="switch"><button className={persona==='female'?'sel':''} disabled={busy} onClick={()=>setPersona('female')}>FEMALE</button><button className={persona==='male'?'sel':''} disabled={busy} onClick={()=>setPersona('male')}>MALE</button></div><div className="notice"><Volume2 size={14}/>{notice}</div>{error&&<div className="error">{error}</div>}</section>
 <footer><span><ShieldCheck size={14}/> VOICE SESSION</span><span><Globe size={14}/> GEMINI LIVE</span></footer>
 {settings&&<div className="shade" onClick={()=>setSettings(false)}><section className="panel" onClick={e=>e.stopPropagation()}><div className="panelhead"><div><small>CONTROL CENTER</small><h2>App settings</h2></div><button className="gear" onClick={()=>setSettings(false)}><X/></button></div><h3>AI PERSONALITY</h3><div className="choices"><button className={persona==='female'?'sel':''} onClick={()=>setPersona('female')}>♀ FEMALE<small>Witty · Warm · Expressive</small></button><button className={persona==='male'?'sel':''} onClick={()=>setPersona('male')}>♂ MALE<small>Sharp · Confident · Friendly</small></button></div><h3>API KEY</h3><div className="keybox"><div className="keyhead"><KeyRound size={16}/><b>Google Gemini API Key</b></div><small>Gemini AI aur Live Voice ke liye{saved?' · Saved: '+maskKey(saved):''}</small><div className="keyrow"><input type={showKey?'text':'password'} value={apiKey} placeholder="Enter Gemini API Key" autoComplete="off" autoCapitalize="off" spellCheck={false} onChange={e=>{setApiKey(e.target.value);setKeyMsg('');}}/><button type="button" onClick={()=>setShowKey(v=>!v)}>{showKey?<EyeOff size={18}/>:<Eye size={18}/>}</button></div><div className="keyactions"><button type="button" onClick={onSaveKey}>SAVE</button><button type="button" onClick={onTestKey}>TEST</button><button type="button" onClick={()=>{setApiKey('');saveKey('');setSaved('');setKeyMsg('Key hata di gayi.');}}>CLEAR</button></div>{keyMsg&&<small className="keymsg">{keyMsg}</small>}</div><h3>ANDROID APP PERMISSIONS</h3><p className="hint">Microphone is required for voice chat. Other permissions are optional and should be granted only when needed.</p>{items.map(([key,label,Icon])=><div className="permission" key={key}><span><Icon size={18}/></span><div><b>{label}</b><small>{perm[key]||'Optional permission'}</small></div><button onClick={()=>request(key)}>ALLOW</button></div>)}<p className="hint">Contacts and Phone are declared in AndroidManifest but their native features are not implemented in this starter. Android may require manual permission management in App info.</p></section></div>}</main>;
}
